{
  "_comment": "Prefer python -m (reliable when Scripts is not on host PATH). memory-hub-mcp works if the console_scripts entry is on PATH.",
  "mcpServers": {
    "multi-agent-memory": {
      "command": "python",
      "args": ["-m", "multi_agent_memory.mcp_server"]
    },
    "multi-agent-memory-via-console-script": {
      "command": "memory-hub-mcp",
      "args": []
    },
    "multi-agent-memory-via-python3": {
      "command": "python3",
      "args": ["-m", "multi_agent_memory.mcp_server"]
    }
  }
}
