{
  "_comment": "Prefer memory-hub-mcp when on PATH. Fallbacks below work on any OS once the package is installed.",
  "mcpServers": {
    "multi-agent-memory": {
      "command": "memory-hub-mcp",
      "args": []
    },
    "multi-agent-memory-via-python": {
      "command": "python",
      "args": ["-m", "multi_agent_memory.mcp_server"]
    },
    "multi-agent-memory-via-python3": {
      "command": "python3",
      "args": ["-m", "multi_agent_memory.mcp_server"]
    }
  }
}
